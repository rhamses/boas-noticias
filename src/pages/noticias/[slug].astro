---
export const prerender = false;

import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPubDate, pubDateTimeAttr } from '../../lib/dates';

const { slug } = Astro.params;
const entry = slug ? await getEntry('noticias', slug) : undefined;

if (!entry) {
  Astro.response.status = 404;
}

const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
---

{
  entry && Content ? (
    <Base title={`${entry.data.title} · Boas Notícias`} description={entry.data.description}>
      <article>
        <h1>{entry.data.title}</h1>
        <p>
          <time datetime={pubDateTimeAttr(entry.data.pubDate)}>{formatPubDate(entry.data.pubDate)}</time>
        </p>
        <p>
          Fonte: <a href={entry.data.sourceUrl}>{entry.data.source}</a>
        </p>
        <Content />
      </article>
      <p>
        <a href="/">Voltar ao início</a>
      </p>
    </Base>
  ) : (
    <Base title="Notícia não encontrada · Boas Notícias">
      <h1>Notícia não encontrada</h1>
      <p>
        <a href="/">Voltar ao início</a>
      </p>
    </Base>
  )
}
