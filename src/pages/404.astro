---
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
---

<Base title="Página não encontrada · Boas Notícias" description="Esse endereço não corresponde a nenhuma página deste site.">
  <div class="notice">
    <h1>Página não encontrada</h1>
    <p>Esse endereço não corresponde a nenhuma página deste site.</p>
    <p>
      <a class="back" href="/">Voltar ao início</a>
    </p>
  </div>
</Base>
